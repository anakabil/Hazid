# ===========================================================================
# Variabel lingkungan Nusa Safety HAZID
# Salin file ini menjadi ".env" untuk uji lokal, dan set nilai yang sama
# di Vercel → Project → Settings → Environment Variables untuk produksi.
# ===========================================================================

# --- Database (Upstash Redis) ---
# Jika memakai integrasi Upstash/Vercel KV dari Marketplace, kedua nilai ini
# biasanya terisi OTOMATIS. Jika membuat database Upstash manual, salin dari
# dashboard Upstash (bagian "REST API").
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Token gerbang aplikasi ---
# Rahasia sederhana untuk membatasi akses ke endpoint /api/kv.
# APP_API_TOKEN (server) HARUS sama persis dengan VITE_API_TOKEN (client).
# Buat string acak panjang, mis. hasil dari: openssl rand -hex 24
APP_API_TOKEN=
VITE_API_TOKEN=
