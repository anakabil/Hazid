/* ------------------------------- Helper akses ------------------------------ */
export function instrumentsByLevel(levelId) {
  return INSTRUMENTS.filter(function (x) { return x.level === levelId; });
}
export function getInstrument(id) {
  return INSTRUMENTS.find(function (x) { return x.id === id; }) || null;
}
export function getSector(id) {
  return SECTORS.find(function (x) { return x.id === id; }) || null;
}
export function getLevel(id) {
  return LEVELS.find(function (x) { return x.id === id; }) || null;
}
